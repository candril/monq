{
  "name": "monq",
  "version": "0.6.0",
  "description": "Terminal-based MongoDB browser and query tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/candril/monq.git"
  },
  "homepage": "https://candril.github.io/monq/",
  "keywords": [
    "mongodb",
    "terminal",
    "tui",
    "cli",
    "database",
    "browser",
    "bun"
  ],
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "monq": "./dist/monq"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "build:all": "bun scripts/build.ts --all"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260329.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "json5": "^2.2.3",
    "mongodb": "^7.6.0",
    "react": "19.3.0",
    "snappy": "^7.4.3"
  }
}
